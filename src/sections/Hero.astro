---
import BotonWa from '../components/BotonWa.astro';
import Foto from '../components/Foto.astro';
import { MSG } from '../lib/site';
---
<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="contenedor">
    <div class="hero__grid">
      <div>
        <h1 class="hero__titulo" id="hero-titulo">
          Canchas de pádel llave en mano
          <span class="hero__acento">Full Panorámica, <em>lista para jugar</em>.</span>
        </h1>
        <p class="hero__bajada">
          Fabricamos, llevamos e instalamos tu cancha en tu galpón o club techado. Vos elegís dónde va; del resto nos encargamos
          nosotros.
        </p>
        <div class="hero__ctas">
          <BotonWa texto={MSG.base} class="btn btn--rojo btn--grande">Quiero mi cancha</BotonWa>
          <a class="btn btn--linea btn--grande" href="#cancha">Ver la cancha</a>
        </div>
      </div>

      <figure class="hero__media">
        <Foto
          nombre="cancha-techada"
          anchos={[800]}
          alto={600}
          sizes="(min-width: 960px) 46vw, 100vw"
          alt="Cancha de pádel Full Panorámica dentro de un galpón, con luces LED"
          prioridad
        />
        <figcaption class="etiqueta">Imagen ilustrativa</figcaption>
      </figure>
    </div>

    <ul class="stats" role="list">
      <li class="stat"><span class="stat__n">24<small>h</small></span><span class="stat__l">para recibir tu presupuesto</span></li>
      <li class="stat">
        <span class="stat__n">30–45</span><span class="stat__l">días hábiles, de la confirmación al primer partido</span>
      </li>
      <li class="stat"><span class="stat__n">2<small>años</small></span><span class="stat__l">de garantía en estructura y mano de obra</span></li>
      <li class="stat">
        <span class="stat__n">Unas 15</span><span class="stat__l">canchas ya fabricó e instaló nuestro equipo</span>
      </li>
    </ul>
  </div>
</section>
