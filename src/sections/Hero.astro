---
import BotonWa from '../components/BotonWa.astro';
import Foto from '../components/Foto.astro';
import { MSG } from '../lib/site';
---
<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="contenedor">
    <div class="hero__grid">
      <div>
        <h1 class="hero__titulo" id="hero-titulo">
          Canchas de pádel llave en mano
          <span class="hero__acento">Full Panorámica y Panorámica, <em>listas para jugar</em>.</span>
        </h1>
        <p class="hero__bajada">
          Fabricamos, llevamos e instalamos tu cancha de pádel. Vos elegís dónde va; del resto nos encargamos nosotros.
        </p>
        <div class="hero__ctas">
          <BotonWa texto={MSG.base} class="btn btn--wa btn--grande">Quiero mi cancha</BotonWa>
          <a class="btn btn--linea btn--grande" href="#cancha">Ver la cancha</a>
        </div>
      </div>

      <figure class="hero__media">
        <Foto
          nombre="cancha-full"
          anchos={[640, 1024]}
          alto={768}
          sizes="(min-width: 960px) 46vw, 100vw"
          alt="Cancha de pádel Full Panorámica de césped azul, dentro de un galpón de ladrillo, con luces LED"
          prioridad
        />
      </figure>
    </div>

    <ul class="stats" role="list">
      <li class="stat"><span class="stat__n">24<small>h</small></span><span class="stat__l">para recibir tu presupuesto</span></li>
    </ul>
  </div>
</section>
