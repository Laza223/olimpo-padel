---
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Cancha from '../sections/Cancha.astro';
import LlaveEnMano from '../sections/LlaveEnMano.astro';
import Pasos from '../sections/Pasos.astro';
import Fabrica from '../sections/Fabrica.astro';
import Techado from '../sections/Techado.astro';
import Preguntas from '../sections/Preguntas.astro';
import Cierre from '../sections/Cierre.astro';
import { fullOffer, formatUSD } from '../../site.config.js';
---
<Base
  title="Canchas de pádel en Argentina | Olimpo Padel"
  description={`Fabricamos canchas Full Panorámica y Panorámica. Full Panorámica a ${formatUSD(fullOffer.price)}, antes ${formatUSD(fullOffer.previousPrice)}. Pedí tu presupuesto detallado por WhatsApp.`}
>
  <Hero />
  <Cancha />
  <LlaveEnMano />
  <Pasos />
  <Fabrica />
  <Techado />
  <Preguntas />
  <Cierre />
</Base>
