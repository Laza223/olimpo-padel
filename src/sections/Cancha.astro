---
import BotonWa from '../components/BotonWa.astro';
import Foto from '../components/Foto.astro';
import OfertaFull from '../components/OfertaFull.astro';
import PrecioPanoramica from '../components/PrecioPanoramica.astro';
import { MSG } from '../lib/site';

const modelos = [
  {
    nombre: 'Full Panorámica',
    model: 'full_panoramica',
    sub: 'Sin postes en las esquinas · Para espacios techados',
    foto: 'cancha-full',
    anchos: [640, 1024],
    alto: 768,
    alt: 'Cancha de pádel Full Panorámica de césped azul, dentro de un galpón de ladrillo, con luces LED',
    texto: MSG.modelo,
    specs: [
      ['Medidas reglamentarias', ': 20 × 10 m'],
      ['18 vidrios templados', ' en fondos y esquinas'],
      ['Esquinas sin postes', ': nada tapa la vista del juego'],
      ['Vidrios sin agujeros', ', sin tornillos a la vista'],
      ['Estructura de acero', ' a medida'],
      ['Césped sintético premium', ' con arena de sílice'],
      ['Iluminación LED', ' con 4 luminarias en mástiles propios'],
      ['Red y postes', ' reglamentarios, incluidos'],
    ],
  },
  {
    nombre: 'Panorámica',
    model: 'panoramica',
    sub: 'Con postes de acero en la estructura',
    foto: 'cancha-panoramica',
    anchos: [640, 1024],
    alto: 1024,
    alt: 'Cancha de pádel Panorámica de césped azul, con vidrios y estructura de acero negra',
    texto: MSG.panoramica,
    specs: [
      ['Medidas reglamentarias', ': 20 × 10 m'],
      ['Vidrios templados', ' en fondos y esquinas'],
      ['Postes de acero', ' en la estructura'],
      ['Estructura de acero', ' a medida'],
      ['Césped sintético premium', ' con arena de sílice'],
      ['Iluminación LED', ' con 4 luminarias en mástiles propios'],
      ['Red y postes', ' reglamentarios, incluidos'],
    ],
  },
];
---
<section class="seccion" id="cancha" aria-labelledby="cancha-titulo">
  <div class="contenedor">
    <h2 class="titulo" id="cancha-titulo">Elegí tu cancha</h2>
    <p class="bajada">Fabricamos dos modelos, los dos llave en mano: la Full Panorámica y la Panorámica.</p>

    <div class="modelos">
      {
        modelos.map((m) => (
          <article class="modelo" data-model={m.model}>
            <figure class="modelo__media">
              <span class="modelo__chip">Estándar 20 × 10&nbsp;m</span>
              <Foto nombre={m.foto} anchos={m.anchos} alto={m.alto} sizes="(min-width: 900px) 46vw, 100vw" alt={m.alt} />
            </figure>
            <div class="modelo__cuerpo">
              <h3 class="modelo__nombre">{m.nombre}</h3>
              <p class="modelo__sub">{m.sub}</p>
              <ul class="specs" role="list">
                {m.specs.map(([fuerte, resto]) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="m8 12.5 2.8 2.8L16.5 9.5" />
                    </svg>
                    <span>
                      <strong>{fuerte}</strong>{resto}
                    </span>
                  </li>
                ))}
              </ul>
              {m.model === 'full_panoramica' && <OfertaFull />}
              {m.model === 'panoramica' && <PrecioPanoramica />}
              <BotonWa texto={m.texto} data-wa-model={m.model} class="btn btn--wa btn--grande btn--ancho">Pedí tu presupuesto</BotonWa>
            </div>
          </article>
        ))
      }
    </div>
    <p class="modelo__nota">¿No tenés galpón? <a href="#techado">También hacemos el techado.</a></p>
  </div>
</section>
